{
  "name": "web-bootstrap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names API,WEB \"npm:api\" \"npm:dev:web\"",
    "dev:web": "vite --port 5173 --strictPort",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "comprobar:navegador": "node scripts/comprobar-navegador.cjs",
    "api": "node --watch server/src/inicio.js",
    "start": "node server/src/inicio.js",
    "configurar:local": "node server/scripts/configurar-local.js",
    "db:preparar": "node server/scripts/preparar-base.js",
    "db:pruebas": "node server/scripts/preparar-base.js --pruebas",
    "admin:crear": "node server/scripts/crear-admin.js",
    "test:api": "node --test server/tests/fotografias.test.js server/tests/integracion.test.js server/tests/proyectos-integracion.test.js server/src/modules/proyectos/validacion.test.js",
    "comprobar:admin": "node scripts/comprobar-admin.cjs",
    "proyectos:importar": "node server/scripts/importar-proyectos.js",
    "comprobar:proyectos": "node scripts/comprobar-proyectos.cjs",
    "comprobar:galeria": "node scripts/comprobar-galeria.cjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "animejs": "^4.5.0",
    "bootstrap": "^5.3.8",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.5",
    "swiper": "^14.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "vite": "^8.2.2"
  }
}
