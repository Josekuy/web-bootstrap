# Copia con npm run configurar:local. Los secretos reales se guardan solo en .env.
SERVER_ENV=development
PORT=3001
HOST=127.0.0.1
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=0
# Vite: en ambos equipos, usa el origen HTTPS del servidor compartido.
# Sin configurar se mantiene la API local en 3001. El panel remoto se abre allí.
API_PROXY_TARGET=
SESSION_SECRET=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portfolio_react
DB_TEST_NAME=portfolio_react_pruebas
DB_USER=portfolio_react_app
DB_PASSWORD=
# TiDB y otras bases gestionadas requieren TLS con certificado verificado.
DB_SSL=0
# Opcional: ruta de la CA del proveedor si no usa una autoridad pública.
DB_SSL_CA_FILE=
# local conserva el comportamiento actual; supabase usa un bucket privado.
IMAGE_STORAGE=local
STORAGE_ROOT=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=portfolio
# Esta cuenta solo se usa al preparar las bases y sus permisos, no en la API.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
ADMIN_USUARIO=admin
ADMIN_CONTRASENA=
