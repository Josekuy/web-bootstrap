# Copia con npm run configurar:local. Los secretos reales se guardan solo en .env.
SERVER_ENV=development
PORT=3001
HOST=127.0.0.1
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=0
SESSION_SECRET=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portfolio_react
DB_TEST_NAME=portfolio_react_pruebas
DB_USER=portfolio_react_app
DB_PASSWORD=
# Esta cuenta solo se usa al preparar las bases y sus permisos, no en la API.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
ADMIN_USUARIO=admin
ADMIN_CONTRASENA=
